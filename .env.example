# 首次启动必填：至少 32 个字符，并在后续启动中保持不变
AI_STUDIO_SESSION_SECRET=replace-with-at-least-32-random-characters
# 原生运行可改用 AI_STUDIO_SESSION_SECRET_FILE，联合 Harness Compose 使用 checkout 外的 TEST_ATELIER_SESSION_KEY_FILE
# AI_STUDIO_SESSION_SECRET_FILE=/absolute/path/to/native-session-secret
# TEST_ATELIER_SESSION_KEY_FILE=/secure/path/to/existing-browser-session-key
AI_STUDIO_ENV=development
# 不要把示例值用于任何共享或生产部署；首次启动管理员密码至少 6 位
AI_STUDIO_ADMIN_USER=admin
AI_STUDIO_ADMIN_PASSWORD=replace-with-strong-admin-password
# 原生可用 AI_STUDIO_ADMIN_PASSWORD_FILE；联合 Harness Compose 使用 TEST_ATELIER_ADMIN_PASSWORD_FILE 宿主机文件（不与内联值同用）
# AI_STUDIO_ADMIN_PASSWORD_FILE=/absolute/path/to/native-bootstrap-password
# TEST_ATELIER_ADMIN_PASSWORD_FILE=/secure/path/to/bootstrap-admin-password
# 浏览器会话有效期，默认 8 小时；生产环境不建议低于 5 分钟
# AI_STUDIO_SESSION_MAX_AGE=28800

# 默认使用本地 SQLite；生产可改为 PostgreSQL
DATABASE_URL=sqlite:///./data/ai_studio.db
# PostgreSQL 示例：postgresql+psycopg://user:password@localhost:5432/ai_studio
# 联合 Harness Compose 使用 checkout 外的 TEST_ATELIER_DB_PASSWORD_FILE，不要同时设置 POSTGRES_PASSWORD 或 DATABASE_URL
# TEST_ATELIER_DB_PASSWORD_FILE=/secure/path/to/existing-postgres-password
# PostgreSQL 连接池（仅非 SQLite 生效）
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# SQLite 并发写入等待秒数（仅本机未启用独立 worker 时生效）
# AI_STUDIO_SQLITE_TIMEOUT=30
# pg_dump/pg_restore 超时秒数
# AI_STUDIO_BACKUP_TIMEOUT=120
# 备份归档解压后的总大小上限，防止恢复压缩炸弹（默认 8 GiB）
# AI_STUDIO_BACKUP_MAX_UNCOMPRESSED_BYTES=8589934592
# 容器部署建议开启迁移版本校验，未升级到 head 时拒绝启动
# AI_STUDIO_REQUIRE_MIGRATIONS=1
# AI_STUDIO_MIGRATION_HEAD=20261046_conversion_output_integrity
# TEST_ATELIER_CASE_RULES_ROOT=/path/to/monitoring-center/qa
# AI_STUDIO_MIGRATION_TIMEOUT=120
# 生产环境默认执行前置配置检查；非 production 环境可显式开启
# AI_STUDIO_REQUIRE_PREFLIGHT=1

# 文档和转换产物目录
# AI_STUDIO_DATA_DIR=./data

# Docker/生产必须提供完整的 qa-doc-skills 源目录（只读挂载）
# TEST_ATELIER_SKILL_ROOT=/absolute/path/to/qa-doc-skills

# DeepSeek Harness Node Host（未完成 Profile/Bridge 验收前保持为空；URL 不要内嵌凭据）
# TEST_ATELIER_HARNESS_URL=http://127.0.0.1:8787
# 仅限隔离的本机管理员 Web Shell 试点；默认关闭，不可作为生产开放开关
# TEST_ATELIER_WEB_SHELL_PILOT=0
# 可选：在已部署受限 `ta-restricted` Profile 后允许有活跃项目成员访问 Shell；默认关闭
# TEST_ATELIER_WEB_SHELL_MEMBER_ACCESS=0
# 成员开关还要求部署明确声明实际使用了受限 Profile；默认关闭
# TEST_ATELIER_WEB_SHELL_RESTRICTED_PROFILE=0
# 生产预检在普通成员开关开启时会失败，直到生产代理和能力边界完成评审
# 以下三项用于原生 Harness Host；联合 Compose 部署的模型 Key 请改用 checkout 外的 TEST_ATELIER_HARNESS_KEY_FILE
# OPENAI_API_KEY=replace-with-rotated-provider-key
# OPENAI_API_BASE=http://code.ugreencloud.com:8000/v1
# OPENAI_MODEL=ugreen-ai-model
# 设为 1 后，需求分析和用例生成拒绝旧的本地 AI 路由，只允许 Harness Bridge
# TEST_ATELIER_HARNESS_ONLY=0
# API Bridge 与 Node Host 共享的短期作用域签名密钥（不要复用浏览器会话密钥）
# TEST_ATELIER_SCOPE_SECRET=replace-with-at-least-32-random-characters
# 原生启动可用作用域密钥环境变量或 TEST_ATELIER_SCOPE_SECRET_FILE（绝对路径），不能同时设置
# TEST_ATELIER_SCOPE_SECRET_FILE=/absolute/path/to/native-scope-key
# 联合 Docker Compose 部署改用 checkout 外的 TEST_ATELIER_SCOPE_KEY_FILE 文件路径；不在 .env 放密钥内容
# TEST_ATELIER_SCOPE_KEY_FILE=/secure/path/to/separate-scope-key
# TEST_ATELIER_HARNESS_TOKEN=replace-with-short-lived-scope-token
# 原生 Host/API 可共用 TEST_ATELIER_HARNESS_TOKEN_FILE；联合 Compose 只使用独立的宿主机源文件
# TEST_ATELIER_HARNESS_TOKEN_FILE=/absolute/path/to/native-host-token
# TEST_ATELIER_HOST_TOKEN_FILE=/secure/path/to/separate-host-token
# TEST_ATELIER_HARNESS_TIMEOUT=30
# TEST_ATELIER_HARNESS_MAX_RESPONSE_BYTES=16777216
# TEST_ATELIER_HARNESS_MAX_REQUEST_BYTES=8388608
# 独立 Harness 任务投影器（API/浏览器断开后仍会持续投影）
# TEST_ATELIER_HARNESS_PROJECTOR_ENABLED=0
# TEST_ATELIER_HARNESS_PROJECTOR_POLL_SECONDS=1
# TEST_ATELIER_HARNESS_PROJECTOR_LEASE_SECONDS=120
# TEST_ATELIER_HARNESS_PROJECTOR_MAX_EVENTS=256
# TEST_ATELIER_HARNESS_PROJECTOR_HEARTBEAT_SECONDS=5
# TEST_ATELIER_HARNESS_PROJECTOR_ID=harness-projector-local
# Node Host 单任务最长运行时间（毫秒，默认 15 分钟；范围 100 至 3600000）
# HARNESS_TASK_TIMEOUT_MS=900000
# Node Host 单次任务请求体上限（字节，默认 8 MiB；范围 64 KiB 至 32 MiB）
# HARNESS_MAX_REQUEST_BYTES=8388608
# Node Host 每个 map/reduce 子进程的 JSONL 输出上限（默认 16 MiB；范围 64 KiB 至 64 MiB）
# HARNESS_MAX_OUTPUT_BYTES=16777216
# 独立 Host 客户端的单条 SSE 事件上限；Test Atelier 创建任务时会用 Bridge 响应预算覆盖此默认值
# HARNESS_MAX_EVENT_FRAME_BYTES=15728640
# 生产环境必须使用 stdin 传递完整 Prompt，避免正文出现在进程参数列表；预检会拒绝 argv
# HARNESS_DSH_INPUT_MODE=stdin
# 原生默认 headless；联合 Compose 默认 SDK ACP 并开启两个技能检查点；回退时同时设置协议 headless 与两个检查点为 0
# Host 未显式设置 HARNESS_DSH_ARGS_JSON 时会自动选择相应 profile
# HARNESS_DSH_PROTOCOL=headless
# 仅官方 SDK ACP 可开启模型原生 Phase 2.5/2.6 交互；headless 下不要设置为 1
# HARNESS_ANALYSIS_CHECKPOINTS=1
# 仅 SDK ACP 可启用用例技能 Phase 2.5/2.6/2.8；与上述开关独立
# HARNESS_CASE_CHECKPOINTS=1
# headless 是一次性运行器，默认不支持后续确认；ACP 使用 JSON-RPC 确认
# HARNESS_CONFIRMATION_TRANSPORT=none
# 普通 Harness 任务的 map/reduce 窗口
# TEST_ATELIER_HARNESS_CHUNK_CHARS=12000
# TEST_ATELIER_HARNESS_CHUNK_OVERLAP_CHARS=400
# TEST_ATELIER_HARNESS_MAX_CHUNKS=128
# 分批传输材料的模型窗口与总时限（不改变每次 HTTP 请求的 8 MiB 上限）
# TEST_ATELIER_HARNESS_STAGED_CHUNK_CHARS=64000
# TEST_ATELIER_HARNESS_STAGED_MAX_CHUNKS=2000
# HARNESS_STAGED_TASK_TIMEOUT_MS=7200000
# 独立 Host 单机并发容量；未完成的分段上传也占名额，到期清理其部分输入
# HARNESS_MAX_ACTIVE_TASKS=4
# HARNESS_STAGED_UPLOAD_TIMEOUT_MS=900000
# Node Host 分层 reduce 的单批 JSON 字符预算和结果数量上限
# HARNESS_REDUCE_BATCH_CHARS=48000
# HARNESS_REDUCE_BATCH_SIZE=16
# Session 只读回放边界（由 Node Host 读取）
# HARNESS_SESSION_MAX_BYTES=8388608
# HARNESS_SESSION_MAX_EVENTS=4000

# 本地 Ollama（可选）
# AI_STUDIO_OLLAMA_URL=http://127.0.0.1:11434
# AI_STUDIO_OLLAMA_MODEL=qwen3:8b

# 远程 OpenAI 兼容模型（默认关闭；仅管理员显式启用）
# AI_STUDIO_REMOTE_ENABLED=1
# AI_STUDIO_REMOTE_URL=https://example.invalid/v1
# AI_STUDIO_REMOTE_MODEL=model-name
# AI_STUDIO_REMOTE_API_KEY=replace-with-secret
# 联合 Harness Compose 禁止内联 AI_STUDIO_REMOTE_API_KEY；若仍需旧远程 Provider，请登录后在模型配置页设置

# 本机 CLI provider（默认关闭；1/true/yes/on 均表示启用；也可登录后在“模型配置”中设置）
# AI_STUDIO_CODEX_ENABLED=1
# AI_STUDIO_CODEX_COMMAND=codex
# AI_STUDIO_CODEX_MODEL=
# AI_STUDIO_CODEX_WORKDIR=  # embedded Codex workspace root (defaults to API cwd)
# AI_STUDIO_CLAUDE_ENABLED=1
# AI_STUDIO_CLAUDE_COMMAND=claude
# AI_STUDIO_CLAUDE_MODEL=
# AI_STUDIO_CLI_TIMEOUT=600  # Codex CLI 工作流不使用人工超时；此值用于其他 CLI 任务和兼容配置
# AI_STUDIO_CLI_TEST_TIMEOUT=45  # must not exceed AI_STUDIO_CLI_TIMEOUT
# 技能仓库辅助脚本超时秒数（例如 XMind 生成），worker 停止/租约失效会提前取消
# AI_STUDIO_SKILL_SCRIPT_TIMEOUT=120
# AI_STUDIO_SHUTDOWN_TIMEOUT=25
# AI_STUDIO_MAX_SUBMITTED_JOBS=100  # 进程内 AI 任务提交上限，防止无界排队
# 生产 Compose 将 AI 任务交给独立 api.worker；本机开发默认关闭
# AI_STUDIO_EXTERNAL_WORKER=0
# AI_STUDIO_WORKER_POLL_SECONDS=1
# AI_STUDIO_WORKER_HEARTBEAT_SECONDS=5
# AI_STUDIO_WORKER_HEARTBEAT=data/.worker-heartbeat
# AI_STUDIO_WORKER_LEASE_SECONDS=900  # must exceed CLI and skill-script timeouts
# 同类数据库/心跳/租约错误日志的限流窗口（秒）
# AI_STUDIO_WORKER_ERROR_LOG_INTERVAL_SECONDS=30
# 登录失败防护（API 进程内防线；生产仍应在反向代理设置登录接口限流）
# AI_STUDIO_LOGIN_FAILURE_LIMIT=8
# AI_STUDIO_LOGIN_FAILURE_WINDOW_SECONDS=60
# API 直接暴露时的 Content-Length 防护；上传接口自身仍限制单文件 20 MB
# AI_STUDIO_MAX_REQUEST_BYTES=26214400
# 项目证据 ZIP 的未压缩字节上限 默认 512 MiB；原始材料和业务结果请按敏感资料保管
# TEST_ATELIER_EXPORT_MAX_BYTES=536870912
# 单次证据导出最多保持数据库读事务 300 秒 超时失败而不是返回部分 ZIP
# TEST_ATELIER_EXPORT_MAX_SECONDS=300
# 仅 API 位于受控反向代理之后时启用，按 X-Real-IP 参与登录失败限流
# AI_STUDIO_TRUST_PROXY_HEADERS=0

# 仅当浏览器通过 HTTPS 反向代理访问时设为 1；生产前置检查强制要求 1
# COOKIE_SECURE=1

# 应用日志（默认 JSON，便于日志平台检索；本地排查可改为 text）
# 可选发布标识（commit SHA/构建号），会写入 API、worker、迁移和备份日志
# AI_STUDIO_RELEASE=2026.10.18+abc123
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_INCLUDE_TRACEBACK=0  # 仅临时排查时开启，默认只记录异常类型

# Prometheus 指标（默认开启；生产前置检查要求至少 16 个字符的访问令牌）
# METRICS_ENABLED=1
# METRICS_TOKEN=replace-with-a-long-random-token
# 原生部署可用 METRICS_TOKEN_FILE（绝对路径），不能与 METRICS_TOKEN 同时设置
# METRICS_TOKEN_FILE=/absolute/path/to/metrics-token
# 联合 Harness Compose 改用 checkout 外的宿主机源文件；不要设置内联 METRICS_TOKEN
# TEST_ATELIER_METRICS_KEY_FILE=/secure/path/to/separate-metrics-token
